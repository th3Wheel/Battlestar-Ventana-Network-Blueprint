# Auto-generated by ansible/roles/openwrt-docker-eval (generate_config task)
# Source of truth: ansible/group_vars/all/vlan-vars.yml
#
# OpenWrt-in-Docker evaluation environment
# Attaches to macvlan bridges for all blueprint VLANs.

services:
  openwrt:
    image: "{{ openwrt_rootfs_image }}"
    container_name: openwrt-eval
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    networks:
{% for item in vlans %}
      - vlan{{ item.id }}-bridge
{% endfor %}
    volumes:
      - ./uci-backup.conf:/etc/openwrt-eval/uci-backup.conf:ro

networks:
{% for item in vlans %}
  vlan{{ item.id }}-bridge:
    driver: macvlan
    driver_opts:
      parent: "{{ openwrt_parent_iface | default('eth0') }}.{{ item.id }}"
    ipam:
      config:
        - subnet: "{{ item.subnet }}"
          gateway: "{{ item.gateway }}"
{% endfor %}
