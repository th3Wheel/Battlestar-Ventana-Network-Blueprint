#!/usr/bin/env bash
# Auto-generated by ansible/roles/linux-router-eval (generate_config task)
# Source of truth: ansible/group_vars/all/vlan-vars.yml
#
# VLAN {{ item.id }} — {{ item.name }}
# Purpose: {{ item.purpose }}
# Subnet:  {{ item.subnet }}
# Gateway: {{ item.gateway }}
{% if item.dhcp_enabled %}
# DHCP:    {{ item.dhcp_range_start }}–{{ item.dhcp_range_end }} ({{ item.lease_time }})
# DNS:     {{ pihole_primary_ip }}
{% else %}
# DHCP:    static assignments only
{% endif %}

set -euo pipefail

IFACE="{{ lan_interface }}.{{ item.id }}"

# Create 802.1Q VLAN interface if not already present
if ! ip link show "${IFACE}" > /dev/null 2>&1; then
  ip link add link {{ lan_interface }} name "${IFACE}" type vlan id {{ item.id }}
fi

ip link set "${IFACE}" up
ip addr add {{ item.gateway }}/24 dev "${IFACE}" 2>/dev/null || true

{% if item.dhcp_enabled %}
# Start lnxrouter DHCP/DNS on this VLAN interface
lnxrouter \
  --no-virt \
  -i "${IFACE}" \
  --dhcp-dns {{ pihole_primary_ip }} \
  --dhcp-no-dns \
  --config-append "dhcp-range={{ item.dhcp_range_start }},{{ item.dhcp_range_end }},{{ item.lease_time }}" \
  &
{% endif %}
