#!/usr/bin/env bash
# Auto-generated by ansible/roles/opnsense-vm-eval (generate_config task)
# Reproducible Proxmox VM creation for the OPNsense evaluation environment
# Source of truth: ansible/group_vars/all/vlan-vars.yml

set -euo pipefail

PROXMOX_HOST="{{ proxmox_host }}"
VMID="{{ opnsense_vm_id }}"
VM_NAME="{{ opnsense_vm_name }}"
ISO="{{ opnsense_iso }}"
BRIDGE="{{ opnsense_vm_bridge }}"

echo "Creating OPNsense evaluation VM (VMID=${VMID}) on ${PROXMOX_HOST}..."

qm create "${VMID}" \
  --name "${VM_NAME}" \
  --memory {{ opnsense_vm_memory_mb }} \
  --cores {{ opnsense_vm_cores }} \
  --scsihw virtio-scsi-pci \
  --scsi0 local-lvm:{{ opnsense_vm_disk_gb }} \
  --ide2 "${ISO},media=cdrom" \
  --net0 virtio,bridge="${BRIDGE}" \
  --net1 virtio,bridge="${BRIDGE}" \
  --boot order=ide2;scsi0 \
  --ostype other

echo "Starting VM ${VMID}..."
qm start "${VMID}"

echo "VM ${VM_NAME} (VMID=${VMID}) started."
echo "OPNsense management IP after first-boot setup: {{ opnsense_mgmt_ip }}"
echo "API credentials must be configured via OPNsense web UI before running configure/validate tags."
