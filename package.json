{
  "name": "battlestar-ventana-network-blueprint",
  "version": "1.0.0",
  "description": "Network documentation and configuration repository",
  "type": "module",
  "scripts": {
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:md": "markdownlint \"**/*.md\"",
    "lint:md:fix": "markdownlint \"**/*.md\" --fix",
    "lint:yaml": "yamllint .",
    "format:yaml": "prettier --write \"**/*.{yml,yaml}\"",
    "mcp:sync": "node scripts/sync-mcp-configs.mjs",
    "mcp:sync:check": "node scripts/sync-mcp-configs.mjs --check",
    "mcp:guard": "node scripts/sync-mcp-configs.mjs --guard",
    "lint": "npm run lint:js && npm run lint:md && npm run lint:yaml",
    "fix": "npm run lint:js:fix && npm run lint:md:fix && npm run format:yaml"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.2",
    "markdownlint-cli": "^0.50.0",
    "prettier": "^3.7.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "network",
    "documentation",
    "vlan",
    "firewall",
    "dhcp"
  ],
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/th3Wheel/Battlestar-Ventana-Network-Blueprint.git"
  },
  "dependencies": {
    "@go-task/cli": "^3.50.0"
  },
  "allowScripts": {
    "@go-task/cli@3.50.0": true
  }
}
