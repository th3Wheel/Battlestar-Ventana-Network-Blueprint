{
  "id": null,
  "uid": "torbox-companion",
  "title": "TorBox Companion – Service Dashboard",
  "tags": ["torbox", "companion", "docker", "radxa"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Service Healthy",
      "id": 1,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "probe_success{instance=\"http://radxa-lan-ip:8300/health\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "timeseries",
      "title": "Healthcheck Latency (probe_duration_seconds)",
      "id": 2,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "probe_duration_seconds{instance=\"http://radxa-lan-ip:8300/health\"}",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "HTTP Status Code",
      "id": 3,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "probe_http_status_code{instance=\"http://radxa-lan-ip:8300/health\"}",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Container CPU Usage",
      "id": 4,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{container=\"torbox-companion\"}[5m])",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Container Memory Usage",
      "id": 5,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "container_memory_usage_bytes{container=\"torbox-companion\"}",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 }
    },
    {
      "type": "stat",
      "title": "Container Last Seen",
      "id": 6,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "container_last_seen{container=\"torbox-companion\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "gridPos": { "x": 12, "y": 12, "w": 6, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Restart Count",
      "id": 7,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "container_restart_count{container=\"torbox-companion\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "gridPos": { "x": 18, "y": 12, "w": 6, "h": 4 }
    }
  ]
}
