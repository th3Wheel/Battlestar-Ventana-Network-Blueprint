#!/bin/sh

# Wi-Fi Credentials
fw_setenv wlanssid "op://homelab/Secureiotwifi/ssid"
fw_setenv wlanpass "op://homelab/Secureiotwifi/password"

# Static IP Configuration
fw_setenv ipaddr 10.10.20.X
fw_setenv gateway 10.10.20.1
fw_setenv netmask 255.255.255.0
fw_setenv dns 10.10.20.1

# Hostname
fw_setenv hostname cam-d1-XXX

# Apply and Reboot
reboot
