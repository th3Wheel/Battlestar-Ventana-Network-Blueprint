/**
 * ESLint Configuration File
 * 
 * This configuration file enforces code quality standards and style consistency
 * across the project using ESLint with Prettier integration.
 * 
 * @file .eslintrc.json
 * 
 * REQUIRED DEPENDENCIES:
 * - eslint
 * - prettier
 * - eslint-config-prettier (CRITICAL: Must be installed for Prettier integration)
 * - @typescript-eslint/parser (For TypeScript file support)
 * - @typescript-eslint/eslint-plugin (For TypeScript linting rules)
 * 

 * 
 * KEY CONFIGURATION POINTS:
 * - Ignores: node_modules, Python virtual environments (.venv, venv)
 * - Environments: Browser, ES2021, and Node.js
 * - Enforces: single quotes, Unix line endings, semicolons
 * - TypeScript files use dedicated parser and recommended rules
 * - Strict equality (eqeqeq) and block statements (curly) are mandatory
 * - Unused variables and console statements generate warnings
 * 
 * NOTE: The 'extends: ["prettier"]' directive requires eslint-config-prettier.
 * Without this package, ESLint will fail during initialization.
 */
{
  "ignorePatterns": ["node_modules/", ".venv/", "venv/"],
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "prettier"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "no-unused-vars": ["warn"],
    "no-console": "warn",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"]
  },
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "extends": [
        "eslint:recommended",
        "prettier"
      ]
    }
  ]
}
