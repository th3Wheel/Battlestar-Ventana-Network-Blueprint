# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = false
insert_final_newline = true

# Keep in step with biome.json (formatter.indentWidth) and .prettierrc.json (tabWidth): all three say 2.
[*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json,jsonc,yml,yaml,html,sh,j2,bashrc}]
indent_size = 2

[{.yamllint,.djlintrc}]
indent_size = 2

# Markdown nesting (ordered-list continuations, blockquotes) is not a multiple of a fixed width
[*.md]
indent_size = unset

# Keep in step with .gitattributes (eol=crlf)
[*.{ps1,bat,cmd}]
end_of_line = crlf
