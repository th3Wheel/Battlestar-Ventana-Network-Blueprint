{
  "default": true,

  // Keep line length checks practical for documentation-heavy tables.
  "MD013": {
    "line_length": 400,
    "tables": false,
    "code_blocks": false,
    "code_blocks": false,
    "headers": true,
    "blockquotes": false,
    "html": false,
  },

  // Allow repeated headings in different sections/releases.
  "MD024": {
    "siblings_only": true,
  },

  // Allow inline HTML and missing first-level heading in some docs.
  "MD033": false,
  "MD041": false,

  // Disable strict table column style checks.
  "MD060": false,
}
