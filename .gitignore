Copilot-Processing.md
.github/copilot/memory/
node_modules/
.venv/
venv/
# Installed Ansible collections belong in ~/.ansible/collections, never in the repo.
ansible/collections/ansible_collections/
*.egg-info/
__pycache__/
.DS_Store
dist/
build/
# Local logs
debug.log

# CodeQL local databases and analysis results
.codeql-db*/
*.sarif

# Per-machine agent settings (Claude Code, Gemini CLI and others); never commit.
**/settings.local.json

# Per-machine and secret files. This mirrors .github/local-files-policy.json, which the
# "Forbid local files" pull request check enforces; tests/local-settings.test.ts fails if a
# forbidden pattern there has no matching rule here. Keep the two in step.
**/*.local.*
.vscode/launch.json
.idea/
.worktrees/
**/.env*
!**/.env.example
**/*.pem
**/*.key
**/id_rsa
**/id_ed25519
**/*.tfstate
**/*.tfstate.*
**/kubeconfig
**/.netrc
