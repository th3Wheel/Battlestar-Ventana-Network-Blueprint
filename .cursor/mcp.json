{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@context7/mcp-server"
      ]
    },
    "home-assistant": {
      "type": "streamable-http",
      "url": "${env:HAMCP_SERVER_URL}",
      "headers": {
        "Authorization": "Bearer ${env:HAMCP_API_TOKEN}"
      }
    },
    "xpipe": {
      "type": "streamable-http",
      "url": "http://localhost:21721/mcp",
      "headers": {
        "Authorization": "Bearer ${env:XPIPE_API_TOKEN}"
      }
    },
    "prompts-chat": {
      "type": "http",
      "url": "https://prompts.chat/api/mcp"
    },
    "gemini-api-docs-mcp": {
      "url": "https://gemini-api-docs-mcp.dev"
    },
    "sentry": {
      "type": "local",
      "command": "npx",
      "args": [
        "@sentry/mcp-server@latest",
        "--host=$SENTRY_HOST"
      ],
      "env": {
        "SENTRY_HOST": "https://contoso.sentry.io",
        "SENTRY_ACCESS_TOKEN": "$COPILOT_MCP_SENTRY_ACCESS_TOKEN"
      }
    }
  }
}
