{
  "profile": "jinja",
  "extension": "yaml,jinja,jinja2,j2,template",
  "indent": 2,
  "max_line_length": 180,
  "format_css": false,
  "format_js": false,
  "ignore": "H006,H021,H025,H030,H031,J018",
  "exclude": "node_modules,.venv,venv",
  "use_gitignore": true,
  "preserve_blank_lines": true,
  "max_blank_lines": 2
}
