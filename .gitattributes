# Set default behavior to automatically normalize line endings.
* text=auto eol=lf

# Force LF for all JavaScript/TypeScript files to satisfy ESLint linebreak-style rule
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Force LF for shell scripts
*.sh text eol=lf
/.shellcheckrc text eol=lf

# Force LF for YAML files
*.yml text eol=lf
*.yaml text eol=lf
/.yamllint text eol=lf

# Force LF for TOML files
*.toml text eol=lf

# Force LF for JSON files
*.json text eol=lf

# Markdown files
*.md text eol=lf

*.txt text eol=lf
*.lock text eol=lf

# Ensure Windows batch files use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
