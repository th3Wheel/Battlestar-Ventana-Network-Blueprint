{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/merge-gate.mts\" --copilot || exit 2",
        "powershell": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/merge-gate.mts\" --copilot; if ($LASTEXITCODE -ne 0) { exit 2 }",
        "timeoutSec": 30
      }
    ]
  }
}
