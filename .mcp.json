{
  "mcpServers": {
    "gemini-api-docs-mcp": {
      "type": "http",
      "url": "https://gemini-api-docs-mcp.dev"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "$CONTEXT7_API_KEY"
      }
    },
    "sentry": {
      "type": "local",
      "command": "npx",
      "args": ["@sentry/mcp-server@latest", "--host=$SENTRY_HOST"],
      "env": {
        "SENTRY_HOST": "https://contoso.sentry.io",
        "SENTRY_ACCESS_TOKEN": "op://Personal/Sentry/bsn token"
      }
    },
    "github-mcp-server": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/github",
      "tools": [
        "repos",
        "issues",
        "pull_requests",
        "actions",
        "code_security",
        "secret_protection",
        "web_search",
        "labels",
        "users",
        "context"
      ],
      "headers": {
        "X-MCP-Toolsets": "repos,issues, labels,users,context, actions, repos ,pull_requests,code_security,secret_protection,actions,web_search"
      }
    },
    "xpipe": {
      "type": "sse",
      "url": "http://localhost:21721/mcp",
      "headers": {
        "Authorization": "Bearer op://homelab/xpipe/mcp_token"
      }
    }
  }
}
