{
  "servers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@context7/mcp-server"
      ]
    },
    "xpipe": {
      "type": "streamable-http",
      "url": "http://localhost:21721/mcp",
      "headers": {
        "Authorization": "Bearer ${env:XPIPE_API_TOKEN}"
      }
    },
    "prompts-chat": {
      "type": "http",
      "url": "https://prompts.chat/api/mcp"
    },
    "gemini-api-docs-mcp": {
      "type": "http",
      "url": "https://gemini-api-docs-mcp.dev"
    },
    "sentry": {
      "type": "local",
      "command": "npx",
      "args": [
        "@sentry/mcp-server@latest",
        "--host=$SENTRY_HOST"
      ],
      "env": {
        "SENTRY_HOST": "https://contoso.sentry.io",
        "SENTRY_ACCESS_TOKEN": "$COPILOT_MCP_SENTRY_ACCESS_TOKEN"
      }
    },
    "github-mcp-server": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/github",
      "tools": [
        "*"
      ],
      "headers": {
        "X-MCP-Toolsets": "repos,issues, labels,users,context, actions, repos ,pull_requests,code_security,secret_protection,actions,web_search"
      }
    }
  }
}
