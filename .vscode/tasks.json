{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "markdownlint: check",
      "type": "shell",
      "command": "markdownlint",
      "args": [
        "**/*.md",
        "-p",
        ".markdownlintignore"
      ],
      "problemMatcher": []
    },
    {
      "label": "markdownlint: fix",
      "type": "shell",
      "command": "markdownlint",
      "args": [
        "**/*.md",
        "-p",
        ".markdownlintignore",
        "--fix"
      ],
      "problemMatcher": []
    }
  ]
}
