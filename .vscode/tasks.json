{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lint: All",
      "dependsOn": [
        "Lint: Markdown",
        "Lint: YAML",
        "Lint: JavaScript/TypeScript",
        "Lint: Python (Ruff)",
        "Lint: Python (ty)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Lint: All Fix",
      "dependsOn": [
        "Format: YAML (Prettier)",
        "Lint: JavaScript/TypeScript Fix",
        "Lint: Python (Ruff) Fix",
        "Format: Python (Ruff)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Lint: Markdown",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint:md"],
      "problemMatcher": "$eslint-stylish",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Lint: YAML",
      "type": "shell",
      "command": "uv",
      "args": ["run", "yamllint", "."],
      "problemMatcher": {
        "owner": "yamllint",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+\\[(error|warning)\\]\\s+(.*)\\s+\\((.*)\\)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5,
          "code": 6
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Format: YAML (Prettier)",
      "type": "shell",
      "command": "powershell",
      "args": ["-Command", "npx prettier --write --no-error-on-unmatched-pattern '**/*.yml' '**/*.yaml'"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Lint: JavaScript/TypeScript",
      "type": "shell",
      "command": "npx",
      "args": ["eslint", "."],
      "problemMatcher": "$eslint-stylish",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Lint: JavaScript/TypeScript Fix",
      "type": "shell",
      "command": "npx",
      "args": ["eslint", ".", "--fix"],
      "problemMatcher": "$eslint-stylish",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Lint: Python (ty)",
      "type": "shell",
      "command": "uv",
      "args": ["run", "ty", "check"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Lint: Python (Ruff)",
      "type": "shell",
      "command": "uv",
      "args": ["run", "ruff", "check", "."],
      "problemMatcher": {
        "owner": "ruff",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(\\w+)\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Lint: Python (Ruff) Fix",
      "type": "shell",
      "command": "uv",
      "args": ["run", "ruff", "check", ".", "--fix"],
      "problemMatcher": {
        "owner": "ruff",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(\\w+)\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Format: Python (Ruff)",
      "type": "shell",
      "command": "uv",
      "args": ["run", "ruff", "format", "."],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}
