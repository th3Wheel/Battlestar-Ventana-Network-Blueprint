    {
      "label": "dotfiles: setup prereqs (dry-run)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "./scripts/setup-dotfiles-env.ps1",
        "-DryRun"
      ],
      "problemMatcher": []
